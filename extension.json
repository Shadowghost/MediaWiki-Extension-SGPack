{
	"name": "SGPack",
	"author": [
		"René Raule",
		"Shadowghost"
	],
	"version": "2.0.0",
	"url": "https://github.com/Shadowghost/MediaWiki-Extension-SGPack",
	"descriptionmsg": "sgpack-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"MessagesDirs": {
		"SGPack": [
			"i18n"
		]
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\SGPack\\": "includes/"
	},
	"ExtensionMessagesFiles": {
		"SGPackMagic": "SGPack.i18n.magic.php"
	},
	"HookHandlers": {
		"default": {
			"class": "MediaWiki\\Extension\\SGPack\\Hooks"
		},
		"newarticle": {
			"class": "MediaWiki\\Extension\\SGPack\\NewArticle"
		},
		"sghtml": {
			"class": "MediaWiki\\Extension\\SGPack\\SGHTML"
		},
		"whosonline": {
			"class": "MediaWiki\\Extension\\SGPack\\AddWhosOnline"
		}
	},
	"Hooks": {
		"ParserFirstCallInit": [
			"default"
		],
		"ParserOptionsRegister": [
			"default"
		],
		"BeforePageDisplay": [
			"sghtml"
		],
		"UserLogout": [
			"whosonline"
		],
		"SkinTemplateNavigation::Universal": [
			"whosonline"
		],
		"EditPage::showEditForm:initial": [
			"newarticle"
		]
	},
	"ResourceFileModulePaths": {
		"localBasePath": "resources",
		"remoteExtPath": "SGPack/resources"
	},
	"ResourceModules": {
		"ext.sgPack": {
			"dependencies": [
				"jquery.textSelection"
			],
			"scripts": [
				"ext.sgPack.js"
			],
			"styles": [
				"ext.sgPack.css"
			]
		},
		"ext.sgPack.sghtml": {
			"scripts": [
				"ext.sgPack.sghtml.js"
			],
			"messages": [
				"sghtml-top"
			]
		},
		"ext.sgPack.sghtml.styles": {
			"styles": [
				"ext.sgPack.sghtml.css"
			]
		},
		"ext.sgPack.audio": {
			"scripts": [
				"ext.sgPack.audio.js"
			],
			"messages": [
				"sgpack-audio-play",
				"sgpack-audio-stop",
				"sgpack-audio-unplayable"
			]
		},
		"ext.sgPack.audio.styles": {
			"styles": [
				"ext.sgPack.audio.css"
			]
		},
		"ext.sgPack.slideshow": {
			"scripts": [
				"ext.sgPack.slideshow.js"
			],
			"messages": [
				"sgpack-slideshow-prev",
				"sgpack-slideshow-next",
				"sgpack-slideshow-play",
				"sgpack-slideshow-pause",
				"sgpack-slideshow-enlarge",
				"sgpack-slideshow-close"
			]
		},
		"ext.sgPack.slideshow.styles": {
			"styles": [
				"ext.sgPack.slideshow.css"
			]
		}
	},
	"config_prefix": "wgSGPack",
	"config": {
		"ImageTop": {
			"value": "/extensions/SGPack/resources/arrow-up-icon.png",
			"path": false,
			"description": "The icon for getting to the top of the site",
			"descriptionmsg": "sgpack-image-top-desc",
			"public": true
		},
		"ImageEdit": {
			"value": "/extensions/SGPack/resources/pencil-edit-icon.png",
			"path": false,
			"description": "The edit icon",
			"descriptionmsg": "sgpack-image-edit-desc",
			"public": true
		},
		"UserStatisticsCacheExpiry": {
			"value": 3600,
			"description": "How long, in seconds, a page using the user statistics tags (<useredit>, <usercreate>, <useredittopten>, <usereditfirst>, <usereditlast>) may be served from the parser cache. 0 keeps such pages out of the parser cache entirely, which is what the original UserStatistics extension did.",
			"descriptionmsg": "sgpack-userstats-cacheexpiry-desc",
			"public": true
		},
		"AudioSeekBar": {
			"value": false,
			"description": "Show a seek bar on inline <audioplay> controls. Off by default: a seek bar needs the clip duration up front, so each control fetches metadata on page load. Individual tags can override this with seek=\"yes\" or seek=\"no\".",
			"descriptionmsg": "sgpack-audio-seekbar-desc",
			"public": true
		}
	},
	"manifest_version": 2
}
