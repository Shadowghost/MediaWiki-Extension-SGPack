{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "Custom preset",
    "extends": [
        "config:base",
        ":disableDependencyDashboard",
        ":enableVulnerabilityAlertsWithLabel(security)",
        ":semanticCommits",
        ":semanticCommitScope(deps)",
        ":timezone(Etc/UTC)",
        "docker:enableMajor",
        "group:testNonMajor",
        "group:monorepos",
        "helpers:pinGitHubActionDigests"
    ],
    "addLabels": [
        "dependencies"
    ],
    "internalChecksFilter": "strict",
    "rebaseWhen": "conflicted",
    "packageRules": [
        {
            "description": "Add the ci and github-actions GitHub label to GitHub Action bump PRs",
            "matchManagers": [
                "github-actions"
            ],
            "addLabels": [
                "ci",
                "github-actions"
            ]
        },
        {
            "description": "Group GitHub Action bumps to one PR as long as they have no major jump",
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "CI dependencies",
            "groupSlug": "ci-deps",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ]
        },
        {
            "description": "Add the npm GitHub label to NPM dependency bump PRs",
            "matchManagers": [
                "npm"
            ],
            "addLabels": [
                "npm"
            ]
        },
        {
            "description": "Hold eslint on 8.x: eslint 9 reads only flat config, while eslint-config-wikimedia 0.32.x still ships eslintrc-style configs and peer-depends on eslint ^8.57.0. Lift this together with the .eslintrc.json -> eslint.config.js migration once upstream supports it.",
            "matchManagers": [
                "npm"
            ],
            "matchPackageNames": [
                "eslint"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "enabled": false
        },
        {
            "description": "grunt-eslint was removed deliberately: v26 depends on eslint ^9 and aborted before linting anything. npm test runs eslint directly instead.",
            "matchManagers": [
                "npm"
            ],
            "matchPackageNames": [
                "grunt-eslint"
            ],
            "enabled": false
        }
    ]
}