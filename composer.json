{
	"name": "mediawiki/sgpack",
	"type": "mediawiki-extension",
	"description": "Extension pack for StargateWiki",
	"homepage": "https://github.com/Shadowghost/MediaWiki-Extension-SGPack",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Shadowghost"
		}
	],
	"support": {
		"wiki": "https://github.com/Shadowghost/MediaWiki-Extension-SGPack/wiki",
		"issues": "https://github.com/Shadowghost/MediaWiki-Extension-SGPack/issues",
		"source": "https://github.com/Shadowghost/MediaWiki-Extension-SGPack"
	},
	"require": {
		"php": ">=8.1",
		"composer/installers": "~2.0"
	},
	"require-dev": {
		"mediawiki/mediawiki-codesniffer": "52.0.0",
		"mediawiki/mediawiki-phan-config": "0.18.0",
		"mediawiki/minus-x": "1.1.3",
		"php-parallel-lint/php-console-highlighter": "1.0.0",
		"php-parallel-lint/php-parallel-lint": "1.4.0",
		"phpunit/phpunit": "9.6.*"
	},
	"scripts": {
		"test": [
			"parallel-lint . --exclude vendor --exclude node_modules",
			"minus-x check .",
			"@phpcs",
			"@phpunit"
		],
		"phpunit": "phpunit",
		"fix": [
			"minus-x fix .",
			"phpcbf"
		],
		"phan": "phan -d . --long-progress-bar",
		"phpcs": "phpcs -sp --cache"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.3.0"
		}
	}
}
